---
import Base from "../layouts/Base.astro";

interface TeamMember {
  name: string;
  link: string;
  imgUrl: string;
  altText?: string;
}

interface WorkingGroup {
  name: string;
  description: string;
  link?: string;
}

const teamMembers: TeamMember[] = [
  {
    name: "Abigail Austin",
    link: "/members/ArachnidAbby",
    imgUrl: "https://avatars.githubusercontent.com/u/38941820?v=4",
  },
  { name: "Ducky Pew", link: "/members/Ducky", imgUrl: "" },
];

const workingGroups: WorkingGroup[] = [
  // {
  //   name: "Recruitment Working Group",
  //   description: "Dedicated to managing hiring decisions for the organization.",
  // },
  // {
  //   name: "Public Records Committee",
  //   description:
  //     "Dedicated to managing and ensuring the access to public records.",
  // },
];
---

<Base title="About — Summersweet Software">
  <section class="max-w-7xl mx-auto px-6 lg:px-10 py-20">
    <p
      class="text-xs font-medium tracking-widest uppercase text-brand-light mb-3"
    >
      Who We Are
    </p>
    <h1
      class="font-[family-name:var(--font-display)] text-3xl font-semibold text-darkest mb-8"
    >
      About Us
    </h1>
    <div class="space-y-5 leading-relaxed text-brand-dark/70">
      <p>
        <strong class="text-darkest font-medium">Summersweet Software</strong> is
        a worker-owned cooperative focused on software engineering. Based in Maryland,
        USA, we build open-source tools and libraries that help developers ship better
        software.
      </p>
      <p>
        As a cooperative, every member has an equal voice in how we operate. We
        believe that shared ownership leads to better software, stronger teams,
        and more sustainable work.
      </p>

      <h2
        class="font-[family-name:var(--font-display)] text-xl font-semibold text-darkest mt-10"
      >
        Our Team
      </h2>
      <div class="flex flex-row gap-5 mb-2">
        {
          teamMembers.map((member) => (
            <a
              href={member.link}
              class="rounded-b-md w-32 h-32 shadow-xs hover:shadow-md shadow-brand hover:border-1 rounded-t-sm"
            >
              <div class="flex justify-center mb-1">
                <img
                  src={member.imgUrl}
                  alt={member.altText ?? "Member Profile Photo"}
                  class="w-24 h-24 text-center rounded-md"
                />
              </div>
              <p class="border-b-1 border-t-1 rounded-md text-center mb-0">
                {member.name}
              </p>
            </a>
          ))
        }
      </div>

      <h2
        class="font-[family-name:var(--font-display)] text-xl font-semibold text-darkest mt-10"
      >
        Working Groups
      </h2>
      <p>
        As per our <a title="(link not yet available)">bylaws</a>, we are
        required to maintain a public list of active working groups.
      </p>

      <div class="flex flex-col gap-4">
        {
          workingGroups.length == 0 ? (
            <p class="italic ml-2">
              Nothing here yet. No working groups have been created yet.
            </p>
          ) : (
            workingGroups.map((group) => (
              <a
                href={group.link}
                class="hover:shadow-xs shadow-brand border-l-2 flex-shrink max-w-212 min-w-128 w-2/3 ml-2"
              >
                <h3
                  class="font-[family-name:var(--font-display)] font-semibold text-darkest ml-4 mr-4 mt-2 mb-1 border-b-1"
                  title={group.name}
                >
                  {group.name}
                </h3>
                <p class="ml-4 mr-4 mb-1 truncate" title={group.description}>
                  {group.description}
                </p>
              </a>
            ))
          )
        }
      </div>

      <h2
        class="font-[family-name:var(--font-display)] text-xl font-semibold text-darkest mt-10"
      >
        Get Involved
      </h2>
      <p>
        We're always looking for contributors and collaborators. Join us on <a
          href="https://discord.gg/CZ3Hfpzdep"
          class="text-brand hover:underline">Discord</a
        > or check out our work on <a
          href="https://github.com/Summersweet-Software/"
          class="text-brand hover:underline">GitHub</a
        >.
      </p>
    </div>
  </section>
</Base>
